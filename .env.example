# Banco de Dados MariaDB (Mesma instância da VM / Disciplina)
DB_HOST=35.226.64.52
DB_USER=usuario_disciplina
DB_PASSWORD=senha_disciplina
DB_NAME=banco_disciplina

# Segredo de Sessão Flask
SECRET_KEY=sua_chave_secreta_flask_aqui

# Porta Externa Alocada para a Stack no Portainer
PORTA_ALUNO=5000

# URL Base da Aplicação (Para links em e-mails e retorno do Stripe)
APP_URL=http://localhost:5000

# Configurações do MinIO (Object Storage S3 para Gravações de Áudio e Logos)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=openwave-midias
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# Endpoints dos Microsserviços Internos (Docker Network)
AUTH_SERVICE_URL=http://auth-service:5000
LOG_SERVICE_URL=http://log-service:5000

# Configurações de E-mail Transacional (Mailtrap em Dev / Brevo em Prod)
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=seu_usuario_mailtrap
MAIL_PASSWORD=sua_senha_mailtrap
MAIL_FROM=no-reply@openwave.local

# Stripe (Plano Sentinela Pro - R$ 9,90/mês)
STRIPE_SECRET_KEY=sk_test_suaChaveSecretaAqui
STRIPE_PUBLISHABLE_KEY=pk_test_suaChavePublicaAqui
STRIPE_WEBHOOK_SECRET=whsec_seuSegredoWebhookAqui
# ID do Preço no painel do Stripe (opcional; se vazio, gera produto dinâmico de R$ 9,90)
STRIPE_PRICE_ID=
